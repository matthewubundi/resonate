# Demo Mode
# Set both to true for the portfolio demo. No Supabase, OpenAI, Gemini, Stripe,
# or Upstash credentials are required when demo mode is enabled.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase Configuration (production mode only)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Configuration (production mode only)
OPENAI_API_KEY=your_openai_api_key

# Google Gemini Configuration (production mode premium model routing only)
GEMINI_API_KEY=your_gemini_api_key

# Stripe Configuration (production mode billing only)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Upstash Redis Configuration (production mode rate limiting only)
# Sign up at https://upstash.com/ and create a Redis database
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
